# Engine and service configuration placeholders. Copy to your environment
# secrets store; never commit real values.

# --- Backend (Railway) ------------------------------------------------------
# Bound address. Railway assigns the public PORT; use the defaults for local dev.
ASTRA_HOST=127.0.0.1
ASTRA_PORT=8790

# Secret: dedicated sender ingestion token (never commit the real value).
ASTRA_SENDER_TOKEN=change-me-sender-token

# Secret: OPTIONAL admin token for the admin quarantine routes
# (GET inspection, DELETE single-row purge on /api/v1/admin/candles). Leave
# unset to disable those routes entirely. Must be a DIFFERENT value from
# ASTRA_SENDER_TOKEN so a leaked sender credential cannot inspect or purge
# stored data.
ASTRA_ADMIN_TOKEN=

# Comma-separated browser origins allowed by CORS (production Cloudflare URL).
ASTRA_ALLOWED_ORIGINS=https://astra-dia.pages.dev

# Where the SQLite candle store lives. Mount a Railway volume here.
ASTRA_DATA_DIR=./data

# --- Windows sender (local PC) ----------------------------------------------
# backend_url = https://astra-server-production.up.railway.app
# sender_token = (same dedicated ingestion token)
# sender_id = pick-a-unique-windows-instance-name

# --- AYZR private mobile surface (news + history) ---------------------------
# Secret: read-only client token for the AYZR Android app (news, analyze,
# history routes). Must DIFFER from ASTRA_SENDER_TOKEN: a leaked read token must
# not be able to write candles. Leave unset to disable the mobile routes (401).
ASTRA_CLIENT_TOKEN=change-me-client-token

# --- News intelligence (LLM7) -----------------------------------------------
# Provider selection: "llm7" (default) or "mock" for offline/dev/testing.
ASTRA_LLM_PROVIDER=llm7
LLM7_BASE_URL=https://api.llm7.io/v1
LLM7_MODEL=nemotron-3-nano:30b
# Secret: LLM7 API token. Server-side only; NEVER embedded in the Android app.
# Leave empty to run the analysis pipeline in an honest `unavailable` state.
LLM7_API_TOKEN=
# Bounded request timeouts and retry cap (no retry storms).
LLM7_CONNECT_TIMEOUT_MS=5000
LLM7_READ_TIMEOUT_MS=45000
LLM7_MAX_ATTEMPTS=2
