# Engine and service configuration placeholders. Copy to your environment
# secrets store; never commit real values.

# --- Backend (Railway) ------------------------------------------------------
# Bound address. Railway assigns the public PORT; use the defaults for local dev.
ASTRA_HOST=127.0.0.1
ASTRA_PORT=8790

# Secret: dedicated sender ingestion token (never commit the real value).
ASTRA_SENDER_TOKEN=change-me-sender-token

# Secret: OPTIONAL admin token for the admin quarantine routes
# (GET inspection, DELETE single-row purge on /api/v1/admin/candles). Leave
# unset to disable those routes entirely. Must be a DIFFERENT value from
# ASTRA_SENDER_TOKEN so a leaked sender credential cannot inspect or purge
# stored data.
ASTRA_ADMIN_TOKEN=

# Comma-separated browser origins allowed by CORS (production Cloudflare URL).
ASTRA_ALLOWED_ORIGINS=https://astra-dia.pages.dev

# Where the SQLite candle store lives. Mount a Railway volume here.
ASTRA_DATA_DIR=./data

# --- Windows sender (local PC) ----------------------------------------------
# backend_url = https://astra-server-production.up.railway.app
# sender_token = (same dedicated ingestion token)
# sender_id = pick-a-unique-windows-instance-name

# --- AYZR private mobile surface (news + history) ---------------------------
# Secret: read-only client token for the AYZR Android app (news, analyze,
# history routes). Must DIFFER from ASTRA_SENDER_TOKEN: a leaked read token must
# not be able to write candles. Leave unset to disable the mobile routes (401).
ASTRA_CLIENT_TOKEN=change-me-client-token

# --- AYZR perpetual candle feeder (biquote) ---------------------------------
# The container runs the backend AND a feeder that polls biquote (public,
# keyless) for closed XAUUSD bars and posts them to the backend over loopback.
# biquote is the sole candle source; W1/MN1 are not offered by it.
AYZR_FEEDER_ENABLED=1
AYZR_FEEDER_INTERVAL_S=30
# Bars fetched per timeframe on the feeder's first run. The engine needs >=200
# closed M15/H4 bars to clear the multi-timeframe gate; 500 gives full context.
AYZR_FEEDER_BACKFILL=500

# --- Supabase candle archive (optional) -------------------------------------
# When both are set, the feeder also upserts every accepted candle into this
# Supabase table, so the archive survives a Railway redeploy. It is a pure
# copy: the engine still reads its local SQLite store, and a Supabase outage
# never interrupts the feed. Leave empty to disable. Apply
# tools/ayzr_agents/supabase/schema.sql once in the Supabase SQL Editor first.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_TABLE=candles

# --- News intelligence (LLM7) -----------------------------------------------
# Provider selection: "auto" (multi-provider failover chain), a single provider
# name ("gemini" | "zai" | "mistral" | "llm7") to pin the pipeline to exactly
# that one, or "mock" for offline/dev/testing.
ASTRA_LLM_PROVIDER=auto

# Failover chain order for "auto" mode. Providers without a credential are
# skipped, so listing one here without its key is harmless. When the first
# provider is rate-limited, out of quota, or rejects the request, the next one
# answers. `GET /api/v1/news/quota` reports the whole-chain verdict.
ASTRA_LLM_ORDER=gemini,zai,mistral,llm7

# --- Provider credentials (server-side only; NEVER in the Android app) ------
# Each is a secret. Leave a key empty to drop that provider from the chain.
# Gemini (native generateContent API; header X-goog-api-key).
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_API_KEY=
GEMINI_READ_TIMEOUT_MS=45000
# z.ai (OpenAI-compatible chat completions).
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.5-flash
ZAI_API_KEY=
ZAI_READ_TIMEOUT_MS=45000
# Mistral (OpenAI-compatible chat completions).
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=open-mistral-nemo
MISTRAL_API_KEY=
MISTRAL_READ_TIMEOUT_MS=45000

# LLM7 (OpenAI-compatible chat completions).
LLM7_BASE_URL=https://api.llm7.io/v1
LLM7_MODEL=nemotron-3-nano:30b
# Secret: LLM7 API token. Server-side only; NEVER embedded in the Android app.
# Leave empty to run the analysis pipeline in an honest `unavailable` state.
LLM7_API_TOKEN=
# Bounded request timeouts and retry cap (no retry storms).
LLM7_CONNECT_TIMEOUT_MS=5000
LLM7_READ_TIMEOUT_MS=45000
LLM7_MAX_ATTEMPTS=2

# --- Hardening limits (backend) ---------------------------------------------
# Per-minute request budgets. The limiter keys on the canonical credential
# (Bearer stripped + trimmed), and an *unauthenticated* attempt on a protected
# route consumes the same budget, so wrong-token guessing is throttled too.
ASTRA_INGEST_RATE_PER_MIN=240
ASTRA_SYNC_RATE_PER_MIN=240
# Largest accepted candle batch (bounded; larger batches get 413).
ASTRA_MAX_CANDLES_PER_BATCH=500
# Cap on concurrent handler threads. A connection over the cap is shed with
# 503 server_busy rather than spawning an unbounded thread.
ASTRA_MAX_CONCURRENT_CONNECTIONS=256
