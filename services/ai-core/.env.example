# AYZR Native AI Core - placeholders only, never real secrets.
AYZR_AI_HOST=127.0.0.1
AYZR_AI_PORT=8090
# Bearer token clients must present. Generate a fresh random value per host.
AYZR_AI_TOKEN=<generate-a-random-token>

# Provider: local (our llama.cpp runtime, the production path) | mock (tests) | external (opt-in)
AYZR_AI_PROVIDER=local
AYZR_AI_LOCAL_URL=http://127.0.0.1:8080
AYZR_AI_LOCAL_MODEL=qwen2.5-1.5b-instruct-q4_k_m
AYZR_AI_LOCAL_TIMEOUT_MS=120000

# External provider is OFF by default and needs explicit opt-in plus a token.
AYZR_AI_EXTERNAL_ENABLED=0
AYZR_AI_EXTERNAL_URL=
AYZR_AI_EXTERNAL_MODEL=
AYZR_AI_EXTERNAL_TOKEN=

# AYZR backend (read-only tool access)
AYZR_BACKEND_URL=http://127.0.0.1:8081
AYZR_BACKEND_CLIENT_TOKEN=<backend-client-token>
AYZR_BACKEND_TIMEOUT_MS=10000

# Generation bounds
AYZR_AI_MAX_OUTPUT_TOKENS=768
AYZR_AI_TEMPERATURE=0.15
AYZR_AI_REQUEST_DEADLINE_MS=180000

# Safety
AYZR_AI_MAX_REQUEST_BYTES=65536
AYZR_AI_RATE_LIMIT=30
AYZR_AI_MAX_HISTORY_TURNS=8
AYZR_AI_MAX_CONTEXT_CHARS=12000

# Tests only: permits the mock provider. Never set in production.
# Constrain the local decoder to Arabic-only output with a GBNF grammar.
# Measured to remove the mixed-language defect entirely. Only the local runtime
# honours it; other providers ignore it.
AYZR_AI_ARABIC_GRAMMAR=1
AYZR_AI_ALLOW_MOCK=0
