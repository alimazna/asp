# ASTRA web — API configuration
#
# Copy to .env.local for local development. Never commit real values or secrets.
# Nothing here is required for `npm run build`; a build with no VITE_API_BASE_URL
# is valid and displays "CLOUD CONNECTION NOT CONFIGURED" rather than guessing.

# ---------------------------------------------------------------------------
# API base URL (the only required variable)
# ---------------------------------------------------------------------------
# Local development, RECOMMENDED (same-origin via the Vite dev proxy below):
#   the app requests /api/v1/... and Vite forwards it to the backend on
#   http://127.0.0.1:8790. This is needed because the loopback backend sends no
#   CORS headers and rejects pre-flight OPTIONS requests.
VITE_API_BASE_URL=/api/v1/

# Local development, direct (only if the backend sends Access-Control-Allow-Origin
# for your dev origin; otherwise the browser will block every request):
# VITE_API_BASE_URL=http://127.0.0.1:8790/api/v1/

# Production / Railway: the HTTPS gateway URL that fronts the user's laptop
# backend. This gateway does not exist in the AURA repository yet — until it is
# deployed and tested, leave it unset or the app will honestly report that the
# cloud connection is not configured. Never hardcode a fictional hostname.
# VITE_API_BASE_URL=https://<your-gateway-host>/api/v1/

# Where the dev proxy forwards /api (defaults to http://127.0.0.1:8790):
# VITE_DEV_API_TARGET=http://127.0.0.1:8790

# ---------------------------------------------------------------------------
# Demo / offline mode
# ---------------------------------------------------------------------------
# VITE_DEMO_MODE=1 switches the app to same-origin /api/v1 (i.e. the local mock)
# and labels every screen "DEMO DATA". Use it when exploring the UI against
# scripts/mock_api.py. Demo data is never mixed silently with a real backend.
# VITE_DEMO_MODE=1
